# Copy to .env and fill in. Vite doesn't hot-reload .env changes — restart
# `npm run dev` after editing.

# The quant0 api-gateway's public host.
#   Local:  http://localhost:8082   (quant0-enterprise `make deps-up && make up`)
#   QA:     https://qa-api.quant0.io   (see quant0-enterprise/deploy/.env.qa.example)
VITE_QUANT0_DOMAIN=http://localhost:8082

# This app's OAuth client_id — register a `single_page` application on
# whichever org-portal matches VITE_QUANT0_DOMAIN above (org-portal ->
# Applications -> Add application), with:
#   Redirect URIs:   http://localhost:3000/callback
#   Allowed origins: http://localhost:3000
#   Password Signup + Magic Link: on
# Local org-portal: http://localhost:3020. QA: https://<your-org-slug>.qa-org.quant0.io.
VITE_QUANT0_CLIENT_ID=

# apps/account-portal's URL, for the "Manage account" bounce.
#   Local: http://localhost:3001 (npm run dev there)
#   QA:    https://qa-account.quant0.io
VITE_ACCOUNT_PORTAL_URL=http://localhost:3001

# Default auth mode shown on first load: "redirect" (hosted, <SignInButton>/
# <SignUpButton>) or "embedded" (<SignIn>/<SignUp> in-page). The app also has
# a runtime toggle, so this is just the starting point.
VITE_QUANT0_DEFAULT_MODE=redirect
